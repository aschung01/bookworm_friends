        <!-- PREVIEW ONLY, and off unless something asks for it. See the note at the top of
             the artboard: this exists so `sheet.py` can judge the glow against the cream the
             celebration actually paints, instead of against the previewer's near-black.
             `ground` defaults to 0 in the view model below and nothing in `lib/` writes it. -->
        <Shape x="152" y="152" name="ground" id="0:33">
            <Rectangle width="304" height="304" name="Path" id="0:249"/>
            <Fill name="Fill" id="0:250"><SolidColor colorValue="FFFFE8C4" name="Color" id="0:251"/></Fill>
            <DataBindContext sourcePathIds="0:100-0:103" propertyKey="18" id="0:252"/>
        </Shape>

        <StateMachine name="Ignite" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120" id="0:253"/>
                <ExitState x="400" y="-120" id="0:254"/>
                <EntryState id="0:255">
                    <StateTransition stateToId="0:70" id="0:256"/>
                </EntryState>
                <!-- The scrub. Weights run 0-100, and the children must be in ascending
                     `value` order -- the runtime binary-searches them and does not check. -->
                <BlendState1DViewModel x="200" id="0:70">
                    <BindablePropertyNumber id="0:257">
                        <DataBindContext sourcePathIds="0:100-0:101" propertyKey="636" id="0:258"/>
                    </BindablePropertyNumber>
                    <BlendAnimation1D animationId="0:60" value="0" id="0:259"/>
                    <BlendAnimation1D animationId="0:61" value="20" id="0:260"/>
                    <BlendAnimation1D animationId="0:62" value="35" id="0:261"/>
                    <BlendAnimation1D animationId="0:63" value="50" id="0:262"/>
                    <BlendAnimation1D animationId="0:64" value="70" id="0:263"/>
                    <BlendAnimation1D animationId="0:65" value="100" id="0:264"/>
                </BlendState1DViewModel>
            </StateMachineLayer>
        </StateMachine>

        <!--
          THE POSES. Every pose keys EVERY blended property: one keyed in one pose and
          absent from another has nothing to mix toward, and jumps instead of blending. So
          these six blocks are the same eleven objects in the same order, every time, and
          they should be read as the columns of one table.

          propertyKey: 13 x, 14 y, 15 rotation, 16 scaleX, 17 scaleY, 18 opacity.
          Values are ABSOLUTE, not offsets -- `fire` is declared at y=196, so a pose that
          wants it 24px lower says 220.
        -->

        <!-- 0 - shut. One board wide, flattened to a slab, covers out and pages hidden.
             No seam, no fire, no light. -->
        <LinearAnimation duration="1" name="p00" id="0:60">
            <KeyedObject objectId="0:27" id="0:265">
                <KeyedProperty propertyKey="16" id="0:266"><KeyFrameDouble value="0.54" id="0:267"/></KeyedProperty>
                <KeyedProperty propertyKey="17" id="0:268"><KeyFrameDouble value="0.34" id="0:269"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:29" id="0:270">
                <KeyedProperty propertyKey="16" id="0:271"><KeyFrameDouble value="0.54" id="0:272"/></KeyedProperty>
                <KeyedProperty propertyKey="17" id="0:273"><KeyFrameDouble value="0.34" id="0:274"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:28" id="0:275">
                <KeyedProperty propertyKey="17" id="0:276"><KeyFrameDouble value="0.02" id="0:277"/></KeyedProperty>
