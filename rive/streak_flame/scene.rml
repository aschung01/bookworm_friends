                    <StraightVertex x="116" y="4" radius="3" id="0:236"/>
                    <StraightVertex x="72" y="-58" radius="3" id="0:237"/>
                    <StraightVertex x="0" y="-64" radius="3" id="0:238"/>
                </PointsPath>
                <Fill name="Fill" id="0:239">
                    <LinearGradient startX="0" startY="-64" endX="0" endY="20" name="Gradient" id="0:240">
                        <GradientStop colorValue="FF35230E" position="0" id="0:241"/>
                        <GradientStop colorValue="FF1B1106" position="1" id="0:242"/>
                    </LinearGradient>
                </Fill>
            </Shape>
        </Node>

        <!-- The light, behind the thing making it. Warmer rather than lighter, which is the
             only kind that reads as light on a cream ground. -->
        <Shape x="152" y="140" name="glow" id="0:32">
            <Ellipse width="250" height="250" name="Path" id="0:243"/>
            <Fill name="Fill" id="0:244">
                <RadialGradient startX="0" startY="0" endX="0" endY="125" name="Gradient" id="0:245">
