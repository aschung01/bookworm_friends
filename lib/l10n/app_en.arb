  "howFarIn": "How far in?",
  "@howFarIn": {
    "description": "Label of the reading-position row in the change-status sheet, and the title of the percent wheel it opens. A question rather than a noun (\"Position\", \"Progress\") because the row is a prompt the reader answers, and because every noun for this collides with books.position or reading_shelf_index."
  },
  "progressPage": "p.{page}",
  "@progressPage": {
    "placeholders": {
      "page": {
        "type": "int"
      }
    }
  },
  "progressOfPages": "/ {total}",
  "@progressOfPages": {
    "description": "The dimmed second half of the band's read-out, following progressPage. Split from it so the total can be drawn at 60% opacity: the page is the answer and the count is context.",
    "placeholders": {
      "total": {
        "type": "int"
      }
    }
  },
  "progressApproxPage": "\u2248 p.{page}",
  "@progressApproxPage": {
    "description": "The percent wheel's derived-page rider. Approximate on purpose: the wheel has 101 stops, so at 320 pages one stop is 3.2 pages and an exact page is not expressible. The tilde is where that cost is admitted to the reader.",
    "placeholders": {
      "page": {
        "type": "int"
      }
    }
  },
  "progressModePercent": "Percent",
  "@progressModePercent": {
    "description": "Left half of the percent/page segment in the position wheel. Always the selected mode when the sheet opens, on every book, so a reader who already knows this sheet sees exactly what they saw before."
  },
  "progressModePage": "Page",
  "@progressModePage": {
    "description": "Right half of the percent/page segment, and also the static column label beside the page wheel. Offered only when the book has a page_count, which is about one reading book in three."
  },
  "progressPageColumn": "Page",
  "@progressPageColumn": {
    "description": "The unit label beside the page wheel, drawn once as a static column heading rather than as a suffix on the centred number. Separate from progressPage because that string is \"p.{page}\" in English and \"{page}\ucabd\" in Korean \u2014 a prefix in one locale and a suffix in the other \u2014 so there is no suffix span to shrink and a prefix would push the digits off centre under the selection overlay."
  },
  "progressPageClamped": "This book ends at p.{total}",
  "@progressPageClamped": {
    "description": "Shown under the keypad when the reader types past the last page. Stated in secondaryText rather than as an error, because the digit simply does not take \u2014 clamping means there is no invalid state to report.",
    "placeholders": {
      "total": {
        "type": "int"
      }
    }
  },
  "readToday": "I read today",
  "@readToday": {
    "description": "Checkbox in the change-status sheet that records one reading day. First person and past tense because the reader is stating a fact about tonight, not setting a preference \u2014 and deliberately not \"Mark as read\", which in a library app means finishing the book."
  },
  "readTodayFailed": "Couldn\u2019t save today\u2019s reading",
  "readingStreakChip": "{days, plural, =0{Start a reading streak} =1{Reading streak: 1 day} other{Reading streak: {days} days}}",
  "@readingStreakChip": {
    "description": "Accessibility label for the library bar's streak chip, which draws a flame and a numeral and would otherwise be read out as a bare number. The zero case says what the chip is for rather than reading out a nothing: the chip is shown at zero on purpose, because only one profile in 137 has any reading day and omitting it hid the feature from everyone else.",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "libraryCardStreak": "Streak",
  "@libraryCardStreak": {
    "description": "Label of the streak tile on the Library Card. A peer of Pace, never the hero \u2014 the hero figure stays the count of books read."
  },
  "libraryCardStreakValue": "{days}d",
  "@libraryCardStreakValue": {
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
  "libraryCardStreakSub": "{days, plural, =1{in a row, best 1} other{in a row, best {days}}}",
  "@libraryCardStreakSub": {
    "description": "Sub-line of the streak tile. Carries the record as well as the run, because with freezes deferred one missed night severs a run outright and the record is the only figure that survives it.",
    "placeholders": {
      "days": {
        "type": "int"
      }
    }
  },
